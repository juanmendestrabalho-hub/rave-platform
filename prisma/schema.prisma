generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  location    String
  city        String
  state       String
  genre       String   // Trance, Techno, House, etc.
  imageUrl    String
  ticketUrl   String
  platform    String   // Sympla, Shotgun, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
